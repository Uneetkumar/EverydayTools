{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tabbench-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "tabbench-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve@14",
        "out",
        "-l",
        "3100",
        "--no-clipboard"
      ],
      "port": 3100
    },
    {
      "name": "ext-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve@14",
        "extension/dist-preview",
        "-l",
        "3200",
        "--no-clipboard"
      ],
      "port": 3200
    }
  ]
}