{
  "hosting": {
    "public": "out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/tools/sample-image-generator",
        "destination": "/tools/sample-file-generator",
        "type": 301
      },
      {
        "source": "/tools/sample-pdf-generator",
        "destination": "/tools/sample-file-generator",
        "type": 301
      },
      {
        "source": "/tools/sample-video-generator",
        "destination": "/tools/sample-file-generator",
        "type": 301
      },
      {
        "source": "/tools/sample-data-generator",
        "destination": "/tools/sample-file-generator",
        "type": 301
      },
      {
        "source": "/tools/youtube-video-downloader",
        "destination": "/tools/video-player",
        "type": 301
      },
      {
        "source": "/tools/instagram-video-downloader",
        "destination": "/tools/video-player",
        "type": 301
      },
      {
        "source": "/tools/facebook-video-downloader",
        "destination": "/tools/video-player",
        "type": 301
      },
      {
        "source": "/tools/tiktok-video-downloader",
        "destination": "/tools/video-player",
        "type": 301
      },
      {
        "source": "/tools/twitter-video-downloader",
        "destination": "/tools/video-player",
        "type": 301
      },
      {
        "source": "/tools/video-downloader",
        "destination": "/tools/video-player",
        "type": 301
      },
      {
        "source": "/tools/simple-calculator",
        "destination": "/tools/calculator",
        "type": 301
      },
      {
        "source": "/tools/basic-calculator",
        "destination": "/tools/calculator",
        "type": 301
      },
      {
        "source": "/tools/pdf-compressor",
        "destination": "/tools/pdf-page-counter",
        "type": 301
      },
      {
        "source": "/tools/24-hour-to-12-hour-converter",
        "destination": "/tools/time-converter",
        "type": 301
      },
      {
        "source": "/tools/12-to-24-hour-converter",
        "destination": "/tools/time-converter",
        "type": 301
      },
      {
        "source": "/tools/military-time-converter",
        "destination": "/tools/time-converter",
        "type": 301
      },
      {
        "source": "/tools/time-format-converter",
        "destination": "/tools/time-converter",
        "type": 301
      },
      {
        "source": "/categories/everyday",
        "destination": "/categories",
        "type": 301
      },
      {
        "source": "/convert/usd-to-inr",
        "destination": "/tools/currency-converter?from=USD&to=INR",
        "type": 301
      },
      {
        "source": "/convert/inr-to-usd",
        "destination": "/tools/currency-converter?from=INR&to=USD",
        "type": 301
      },
      {
        "source": "/convert/aed-to-inr",
        "destination": "/tools/currency-converter?from=AED&to=INR",
        "type": 301
      },
      {
        "source": "/convert/eur-to-inr",
        "destination": "/tools/currency-converter?from=EUR&to=INR",
        "type": 301
      },
      {
        "source": "/convert/gbp-to-inr",
        "destination": "/tools/currency-converter?from=GBP&to=INR",
        "type": 301
      },
      {
        "source": "/convert/sar-to-inr",
        "destination": "/tools/currency-converter?from=SAR&to=INR",
        "type": 301
      },
      {
        "source": "/convert/cad-to-inr",
        "destination": "/tools/currency-converter?from=CAD&to=INR",
        "type": 301
      },
      {
        "source": "/convert/aud-to-inr",
        "destination": "/tools/currency-converter?from=AUD&to=INR",
        "type": 301
      },
      {
        "source": "/convert/sgd-to-inr",
        "destination": "/tools/currency-converter?from=SGD&to=INR",
        "type": 301
      },
      {
        "source": "/convert/kwd-to-inr",
        "destination": "/tools/currency-converter?from=KWD&to=INR",
        "type": 301
      },
      {
        "source": "/convert/usd-to-eur",
        "destination": "/tools/currency-converter?from=USD&to=EUR",
        "type": 301
      },
      {
        "source": "/convert/gbp-to-usd",
        "destination": "/tools/currency-converter?from=GBP&to=USD",
        "type": 301
      },
      {
        "source": "/convert/**",
        "destination": "/tools/currency-converter",
        "type": 301
      },
      {
        "source": "/convert",
        "destination": "/tools/currency-converter",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**/opengraph-image",
        "headers": [
          { "key": "Content-Type", "value": "image/png" },
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      },
      {
        "source": "/apple-icon",
        "headers": [
          { "key": "Content-Type", "value": "image/png" },
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/vendor/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/models/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=2592000" }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=2592000" }
        ]
      },
      {
        "source": "/@(tool-index.json|tools.csv)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
          { "key": "X-Robots-Tag", "value": "noindex" }
        ]
      },
      {
        "source": "/@(sw.js|offline-manifest.json)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "X-Robots-Tag", "value": "noindex" }
        ]
      },
      {
        "source": "**/!(robots|ads).txt",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex" }
        ]
      },
      {
        "source": "/@(sitemap*.xml|robots.txt|ads.txt)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      },
      {
        "source": "/sitemap.xsl",
        "headers": [
          { "key": "Content-Type", "value": "text/xsl; charset=utf-8" },
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      },
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "X-XSS-Protection", "value": "1; mode=block" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
          { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=()" },
          { "key": "Content-Language", "value": "en" },
          { "key": "Vary", "value": "Accept-Encoding" }
        ]
      }
    ]
  }
}
